cmake_minimum_required(VERSION 3.18)
project(${PROJECT_NAME})

set(CMAKE_CXX_STANDARD 20)

if (MSVC)
    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreadedDLL")
    add_compile_options(/MP)
endif()

# VulkanSDK path
set(VULKAN_SDK "$ENV{VULKAN_SDK}" CACHE PATH "Path to VulkanSDK")

# Validate VulkanSDK
if(NOT VULKAN_SDK OR NOT EXISTS "${VULKAN_SDK}")
    message(FATAL_ERROR
        "\nVulkanSDK not configured. VULKAN_SDK variable not set.\n"
        "Please, set the VulkanSDK path manually:\n"
        "  -DVULKAN_SDK=/path/to/VulkanSDK\n\n"
    )
endif()
message(STATUS "Vulkan SDK found at: ${VULKAN_SDK}")

# Find dependencies
list(APPEND CMAKE_MODULE_PATH "${CMAKE_SOURCE_DIR}/cmake")
find_package(SDL2 REQUIRED)
find_package(Vulkan REQUIRED)

# Import pre-compiled bg2e library
add_library(bg2e SHARED IMPORTED)
if(WIN32)
    set_target_properties(bg2e PROPERTIES
        IMPORTED_LOCATION "${CMAKE_SOURCE_DIR}/lib/windows/bg2e.dll"
        IMPORTED_IMPLIB "${CMAKE_SOURCE_DIR}/lib/windows/bg2e.lib"
    )
elseif(APPLE)
    set_target_properties(bg2e PROPERTIES
        IMPORTED_LOCATION "${CMAKE_SOURCE_DIR}/lib/macos/libbg2e.dylib"
    )
else()
    set_target_properties(bg2e PROPERTIES
        IMPORTED_LOCATION "${CMAKE_SOURCE_DIR}/lib/linux/libbg2e.so"
    )
endif()

# Include standalone utilities
include("${CMAKE_SOURCE_DIR}/cmake/standalone_utils.cmake")

# Application
add_subdirectory(app)
